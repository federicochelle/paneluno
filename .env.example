# Frontend variables: Vite exposes only variables with the VITE_ prefix.
VITE_SUPABASE_URL=<SUPABASE_PROJECT_URL>
VITE_SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>
VITE_DEV_BYPASS_AUTH=false

# Server variables: these are read only by Express and are never bundled into the frontend.
# SUPABASE_URL and SUPABASE_ANON_KEY are required.
PORT=3000
SUPABASE_URL=<SUPABASE_PROJECT_URL>
SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>
# At least one administrative allowlist is required by the server.
SUPABASE_ADMIN_USER_IDS=<SUPABASE_USER_UUIDS_COMMA_SEPARATED>
SUPABASE_ADMIN_EMAILS=<ADMIN_EMAILS_COMMA_SEPARATED>
